// Para cuando la web pase a Cloudflare Workers (Workers Builds conectado al
// repo). Allí va con dominio propio: cambia "url" en content/site.json.
{
  "name": "almarbra",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node build/build.mjs" },
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
